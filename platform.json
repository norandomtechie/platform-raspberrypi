{
  "name": "raspberrypi",
  "title": "Raspberry Pi RP2350",
  "description": "RP2350 is a low-cost, high-performance microcontroller device with a large on-chip memory, symmetric dual-core processor complex, and rich peripheral.",
  "homepage": "https://www.raspberrypi.org/documentation/rp2350/getting-started/",
  "license": "Apache-2.0",
  "keywords": [
    "dev-platform",
    "ARM",
    "Cortex-M",
    "Raspberry Pi",
    "RP2350"
  ],
  "engines": {
    "platformio": "^6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/platformio/platform-raspberrypi.git"
  },
  "version": "1.16.0",
  "frameworks": {
    "picosdk": {
      "package": "framework-picosdk",
      "script": "builder/frameworks/picosdk.py"
    }
  },
  "packages": {
    "toolchain-gccarmnoneeabi": {
      "type": "toolchain",
      "owner": "platformio",
      "version": ">=1.90201.0,<1.90302.0"
    },
    "framework-picosdk": {
      "type": "framework",
      "optional": true,
      "owner": "platformio",
      "version": "https://github.com/maxgerhardt/pico-sdk.git"
    },
    "tool-picotool-rp2040-earlephilhower": {
      "type": "uploader",
      "optional": false,
      "owner": "platformio",
      "version": "https://github.com/maxgerhardt/picotool-dummy/archive/refs/heads/main.zip"
    },
    "tool-pioasm-rp2040-earlephilhower": {
      "type": "toolchain",
      "optional": false,
      "owner": "platformio",
      "version": "https://github.com/earlephilhower/pico-quick-toolchain/releases/download/4.0.1/x86_64-linux-gnu.pioasm-efe2103.240929.tar.gz"
    },
    "tool-openocd-rp2040-earlephilhower": {
      "type": "uploader",
      "optional": true,
      "owner": "earlephilhower",
      "version": "~5.100300.0"
    },
    "tool-mklittlefs-rp2040-earlephilhower": {
      "type": "uploader",
      "optional": true,
      "owner": "earlephilhower",
      "version": "~5.100300.0"
    }
  }
}
